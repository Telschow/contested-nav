# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.venv/
venv/

# Coverage and profiling
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof
*.lprof

# Local agent tooling config, not project source.
#
# `opencode.json` is listed separately from `.opencode/` because it sits at the
# repo root and carries a provider API key. Ignoring the directory alone left it
# stageable, so a `git add .` would have committed a live credential.
.opencode/
opencode.json

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Datasets and generated artefacts
#
# Third-party datasets (TUM VI, EuRoC) are not vendored; fetch them locally.
# Reproducibility comes from seeded configs plus committed figures, not from
# committing megabytes of raw capture.
data/raw/
data/subsets/
*.bag
*.db3

# Benchmark output. Figures under docs/figures/ ARE committed on purpose:
# they are the evidence behind the numbers quoted in README.md and docs/.
results/
# Output of scripts/generate_demo.py (regenerated by tests and by hand).
artifacts/
*.json.tmp
coverage.json
