# Files whose exact bytes are hashed or compared by tests must not be rewritten to CRLF by a
# Windows checkout. `config_sha256` in every result is the hash of configs/benchmark.yaml, and the
# first Windows CI leg failed because autocrlf changed the bytes and so the hash.
configs/*.yaml text eol=lf
tests/golden/*.json text eol=lf
# The FDIR study CSVs are written with LF and compared byte for byte in tests.
docs/data/fdir_false_alarm.csv text eol=lf
docs/data/fdir_sensitivity.csv text eol=lf
